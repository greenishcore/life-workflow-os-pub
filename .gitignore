# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?

# 个人数据默认就在仓库之外（~/LifeWorkflowOS/，见 lifeos/config.py 的 LIFEOS_HOME）。
# 下面几条是双保险：万一有人把 LIFEOS_HOME 指回仓库，私人内容也不会被提交。
# 注意前导斜杠——只锚定仓库根，不会误伤 seed/vault 这类随仓库分发的模板。
/vault/
/logs/
/prompts/
/skills/

# 凭据
secrets.env
.env
*.key
*.pem
credentials*.json
token*.json

# Obsidian（整体不纳入版本控制：工作区状态 + 个人配置，含根与 vault/ 下）
**/.obsidian/
.trash/

# 依赖与构建产物
node_modules/
dist/
build/
__pycache__/
*.pyc
.venv/
venv/

# 转换缓存（可重建，无需入库）
.cache/
converted/

# 快照夹具与产物（由 tools/snapshot.sh 从 seed/ 重建）。
# 18 张图约 7MB，每次设计改动都重传会把仓库撑大，因此基线不入库——
# 它是本地反馈回路，不是版本化产物。
.snap/
.snapshots/

# 本地签名配置：Team ID 绑定个人身份，不进公开仓库
apple/LifeOSApp/Signing.local.xcconfig

# 系统
*.log

# 应用打包产物（可由 tools/build_app.sh 重建；dist/ 已在上方忽略）
assets/icon-*.png.tmp

# Swift / Xcode 构建产物（均可重建）
# .xcodeproj 由 xcodegen 从 project.yml 生成，不入库以免合并冲突
*.xcodeproj/
.build/
.swiftpm/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
