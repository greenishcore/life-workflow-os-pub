# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?

# 隐私/敏感数据（个人笔记默认不进公开仓库；如使用私有仓库可放开）
# 建议：个人 vault 内容单独一个私有仓库，本仓库只放「系统/脚本/模板/文档」
secrets.env
.env
*.key
*.pem
credentials*.json
token*.json

# Obsidian（整体不纳入版本控制：工作区状态 + 个人配置，含根与 vault/ 下）
**/.obsidian/
.trash/

# 依赖与构建产物
node_modules/
dist/
build/
__pycache__/
*.pyc
.venv/
venv/

# 转换缓存（可重建，无需入库）
.cache/
converted/

# 转换运行时产物（原始输入/中间态/生成输出均为可重建文件）
vault/Attachments/_raw/
vault/Attachments/_md/
vault/Attachments/_out/

# 日志中可能含隐私；按需忽略，默认保留结构化日志但排除原始敏感字段
logs/*.private.jsonl

# 系统
*.log

# 应用打包产物（可由 tools/build_app.sh 重建；dist/ 已在上方忽略）
assets/icon-*.png.tmp

# Swift / Xcode 构建产物（均可重建）
.build/
.swiftpm/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
